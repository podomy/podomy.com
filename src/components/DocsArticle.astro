---
interface DocNavItem {
	slug: string;
	label: string;
}

interface Props {
	doc: any;
	docsNav: DocNavItem[];
	activeSlug: string;
	prevDoc: DocNavItem | null;
	nextDoc: DocNavItem | null;
	basePath: string;
	indexSlug: string;
	productLabel?: string;
}

const { doc, docsNav, activeSlug, prevDoc, nextDoc, basePath, indexSlug, productLabel = "Concord" } = Astro.props;
const { Content } = doc;

// Docs index URL for a slug: the collection root for the index doc,
// otherwise the slug route.
function docHref(slug: string): string {
	return slug === indexSlug ? `${basePath}/` : `${basePath}/${slug}/`;
}
---

<div class="docs-wrapper">
	<div class="docs-mobile-top">
		<p class="docs-index-label">{productLabel}</p>
		<nav class="docs-index-nav-mobile" aria-label="Documentation pages">
			<ul class="docs-index-chips">
				{docsNav.map((item) => (
					<li>
						{item.slug === activeSlug ? (
							<span class="is-active" aria-current="page">{item.label}</span>
						) : (
							<a href={docHref(item.slug)}>{item.label}</a>
						)}
					</li>
				))}
			</ul>
		</nav>
	</div>

	<div class="docs-layout">
		<nav class="docs-index-nav" aria-label="Documentation pages">
			<p class="docs-index-label">{productLabel}</p>
			<ul class="docs-index">
				{docsNav.map((item) => (
					<li>
						{item.slug === activeSlug ? (
							<span class="is-active" aria-current="page">{item.label}</span>
						) : (
							<a href={docHref(item.slug)}>{item.label}</a>
						)}
					</li>
				))}
			</ul>
		</nav>

		<div class="docs-main">
			<article class="markdown-body">
				<Content />
			</article>

			<div class="docs-pagination">
				{prevDoc ? (
					<a
						href={docHref(prevDoc.slug)}
						class="docs-pag-btn prev"
					>
						<span class="docs-pag-sub">&larr; Previous</span>
					</a>
				) : <div class="docs-pag-placeholder" />}
				{nextDoc ? (
					<a
						href={docHref(nextDoc.slug)}
						class="docs-pag-btn next"
					>
						<span class="docs-pag-sub">Next &rarr;</span>
					</a>
				) : <div class="docs-pag-placeholder" />}
			</div>
		</div>
	</div>
</div>

<script>
	/** Mark soft-wrapped rows in labeled code blocks with a gutter glyph. */
	function markWrappedLines() {
		var blocks = document.querySelectorAll(
			'.markdown-body pre.astro-code:not([data-language="plaintext"])'
		);
		blocks.forEach(function (pre) {
			pre.querySelectorAll(".wrap-mark").forEach(function (mark) {
				mark.remove();
			});
			var preRect = pre.getBoundingClientRect();
			var preStyle = window.getComputedStyle(pre);
			var gutterLeft =
				(parseFloat(preStyle.borderLeftWidth) || 0) +
				(parseFloat(preStyle.paddingLeft) || 0) +
				2;
			var gutterTop = parseFloat(preStyle.borderTopWidth) || 0;
			pre.querySelectorAll(".line").forEach(function (line) {
				var lineStyle = window.getComputedStyle(line);
				var rowHeight = parseFloat(lineStyle.lineHeight);
				if (!rowHeight || rowHeight <= 0) {
					rowHeight = parseFloat(lineStyle.fontSize) * 1.6;
				}
				var rect = line.getBoundingClientRect();
				if (rect.width <= 0 || rect.height <= 0) return;
				var rows = Math.round(rect.height / rowHeight);
				for (var i = 1; i < rows; i++) {
					var mark = document.createElement("span");
					mark.className = "wrap-mark";
					mark.setAttribute("aria-hidden", "true");
					mark.style.left = gutterLeft + "px";
					mark.style.top =
						rect.top - preRect.top - gutterTop + i * rowHeight + "px";
					mark.style.lineHeight = rowHeight + "px";
					pre.appendChild(mark);
				}
			});
		});
	}

	/** Show a scroll hint on diagram blocks that overflow horizontally. */
	function updateScrollHints() {
		var blocks = document.querySelectorAll(
			'.markdown-body pre[data-language="plaintext"]'
		);
		blocks.forEach(function (pre) {
			var hint = pre.previousElementSibling;
			if (!hint || !hint.classList.contains("scroll-hint")) {
				hint = document.createElement("div");
				hint.className = "scroll-hint";
				hint.setAttribute("aria-hidden", "true");
				hint.innerHTML =
					'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="8 8 5 12 8 16"></polyline><polyline points="16 8 19 12 16 16"></polyline></svg><span>Scroll</span>';
				pre.before(hint);
				pre.addEventListener("scroll", updateScrollHints, { passive: true });
			}
			var canScroll = pre.scrollWidth > pre.clientWidth + 2;
			if (canScroll) hint.classList.add("is-visible");
			else hint.classList.remove("is-visible");
		});
	}

	/** Wrap markdown tables in a scroll container for proper column fill. */
	function wrapTables() {
		document.querySelectorAll(".markdown-body table").forEach(function (table) {
			if (
				table.parentElement &&
				table.parentElement.classList.contains("table-scroll")
			)
				return;
			var wrap = document.createElement("div");
			wrap.className = "table-scroll";
			table.before(wrap);
			wrap.appendChild(table);
		});
	}

	/** Debounced re-marking for viewport and font changes. */
	var markTimer = 0;
	function scheduleDocsEnhance() {
		if (markTimer) window.clearTimeout(markTimer);
		markTimer = window.setTimeout(function () {
			markWrappedLines();
			updateScrollHints();
		}, 150);
	}

	document.addEventListener("DOMContentLoaded", function () {
		markWrappedLines();
		updateScrollHints();
		wrapTables();
	});
	window.addEventListener("resize", scheduleDocsEnhance);
	if (document.fonts && document.fonts.ready) {
		document.fonts.ready.then(function () {
			markWrappedLines();
			updateScrollHints();
		});
	}
	markWrappedLines();
	updateScrollHints();
	wrapTables();
</script>
