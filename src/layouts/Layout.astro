---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	currentPath?: string;
	docsNav?: Array<{ slug: string; label: string; order?: number }>;
	activeSlug?: string;
}

const {
	title = "Podomy | Distributed Systems & Computational Engineering",
	description = "Podomy builds distributed systems, computational engineering tools, and simulation software for physical machines and decentralized networks.",
	currentPath = "/",
	docsNav,
	activeSlug,
} = Astro.props;

const navItems = [
	{ label: "About", href: "/" },
	{ label: "Concord", href: "/concord/" },
	{ label: "Docs", href: "/docs/" },
	{ label: "Pricing", href: "/pricing/" },
	{ label: "Contact", href: "/contact/" },
];

const footerLinks = [
	{ label: "Pricing", href: "/pricing/" },
	{ label: "Contact", href: "/contact/" },
	{ label: "Terms", href: "/terms/" },
];

const products = [
	{
		id: "concord",
		name: "Concord",
		href: "/concord/",
		logo: "/assets/concord-robot-light.png",
	},
];

const activeProduct = "concord";

const footerSocial = [
	{
		label: "X",
		href: "https://x.com/polypodomy",
		path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z",
	},
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/company/podomy/",
		path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
	},
];

const canonicalUrl = `https://podomy.com${currentPath.replace(/\/+$/, "") || "/"}${currentPath === "/" ? "" : "/"}`;
const isDocPage = currentPath.startsWith("/docs/");
const rawMarkdownUrl = isDocPage 
	? `https://podomy.com/docs/${activeSlug || "overview"}.md` 
	: undefined;

const jsonLd = isDocPage ? {
	"@context": "https://schema.org",
	"@type": "TechArticle",
	"headline": title,
	"description": description,
	"url": canonicalUrl,
	"inLanguage": "en",
	"author": {
		"@type": "Organization",
		"name": "Podomy",
		"url": "https://podomy.com"
	},
	"publisher": {
		"@type": "Organization",
		"name": "Podomy",
		"url": "https://podomy.com",
		"logo": "https://podomy.com/logo.png"
	}
} : {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "Concord",
	"applicationCategory": "DistributedSystemsApplication",
	"operatingSystem": "Linux, Embedded POSIX",
	"description": "Partition-native coordination layer for autonomous physical machines.",
	"url": "https://podomy.com/concord/",
	"author": {
		"@type": "Organization",
		"name": "Podomy",
		"url": "https://podomy.com"
	}
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="help" type="text/plain" href="/llms.txt" title="LLM Context Manifest" />
		<link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full Documentation LLM Bundle" />
		{rawMarkdownUrl && (
			<link rel="alternate" type="text/markdown" href={rawMarkdownUrl} title="Raw Markdown Content" />
		)}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<ClientRouter />
	</head>
	<body>
		<div class="site-chrome">
			{isDocPage && (
				<div class="product-bar">
					<a href="/" class="product-bar-brand brand-link" aria-label="Podomy home">
						<span class="brand-logo" aria-hidden="true"></span>
						<span class="brand-name">Podomy</span>
					</a>
					<nav class="product-tabs" aria-label="Products">
						{products.map((product) => (
							<a
								href={product.href}
								class:list={["product-tab", { active: product.id === activeProduct }]}
							>
								<span class="product-tab-name">{product.name}</span>
								<img
									src={product.logo}
									alt=""
									width="72"
									height="72"
									class="product-tab-logo"
								/>
							</a>
						))}
					</nav>
				</div>
			)}
			<div class:list={["layout-grid", { "docs-layout": isDocPage }]}>
				<aside class="sidebar">
					<div class="sidebar-sticky">
						{!isDocPage && (
							<div class="brand">
								<a href="/" class="brand-link">
									<span class="brand-logo" aria-hidden="true"></span>
									<span class="brand-name">Podomy</span>
								</a>
							</div>
						)}
						{docsNav && docsNav.length > 0 ? (
							<nav class="nav-links docs-nav">
								{docsNav.map((doc) => {
									const docHref = doc.slug === "overview" ? "/docs/" : `/docs/${doc.slug}/`;
									const isDocActive = activeSlug === doc.slug;
									return (
										<a
											href={docHref}
											class:list={["docs-sidebar-link", { active: isDocActive }]}
										>
											{doc.label}
										</a>
									);
								})}
							</nav>
						) : (
							<nav class="nav-links">
								{navItems.map((item) => {
									const normalizedCurrent = currentPath.replace(/\/+$/, "") || "/";
									const normalizedItem = item.href.replace(/\/+$/, "") || "/";
									const isActive = normalizedItem === "/" 
										? normalizedCurrent === "/" 
										: normalizedCurrent === normalizedItem || normalizedCurrent.startsWith(normalizedItem + "/");
									return (
										<div class="nav-item-group">
											<a
												href={item.href}
												class:list={["nav-link", { active: isActive }]}
											>
												{item.label}
											</a>
										</div>
									);
								})}
							</nav>
						)}
					</div>
				</aside>

				<div class="main-column">
					<main>
						<slot />
					</main>

					<footer>
						<div class="footer-inner">
							<span class="footer-legal">&copy; 2026 Podomy &middot; Forge Universal LLC</span>
							<div class="footer-nav">
								{footerLinks.map((item) => (
									<a href={item.href} class="footer-link">{item.label}</a>
								))}
								{footerSocial.map((item) => (
									<a
										href={item.href}
										class="footer-link footer-icon-link"
										target="_blank"
										rel="noopener noreferrer"
										aria-label={item.label}
									>
										<svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true">
											<path fill="currentColor" d={item.path} />
										</svg>
									</a>
								))}
							</div>
						</div>
					</footer>
				</div>
			</div>
		</div>
	</body>
</html>
