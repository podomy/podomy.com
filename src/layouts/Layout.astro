---
import "../styles/global.css";
import BrandLink from "../components/BrandLink.astro";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  rawMarkdownUrl?: string;
}

const {
  title = "Podomy | Distributed Systems for Robotic Fleets",
  description = "We build distributed systems for robotic fleets.",
  currentPath = "/",
  rawMarkdownUrl,
} = Astro.props;

const navItems = [
  { label: "About", href: "/" },
  { label: "Concord", href: "/concord/" },
  { label: "Flint", href: "/flint/" },
  { label: "Docs", href: "/docs/" },
  { label: "Pricing", href: "/pricing/" },
  { label: "Contact", href: "/contact/" },
];

const footerLinks = [
  { label: "Pricing", href: "/pricing/" },
  { label: "Contact", href: "/contact/" },
  { label: "Terms", href: "/terms/" },
];

const footerSocial = [
  {
    label: "GitHub",
    href: "https://github.com/podomy",
    path: "M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.225.825-.51 0-.255-.015-.93-.015-1.62-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23.54.825 1.62 1.41 2.67 1.395.42-.33.795-.855.93-1.41-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.105-3.195 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.645 1.665.225 2.895.105 3.195.765.84 1.23 1.92 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .285.225.63.825.51A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z",
  },
  {
    label: "Slack",
    href: "https://join.slack.com/t/podomy/shared_invite/zt-4bahp87kw-7RAqw44bBxG~RVPhcExYkA",
    path: "M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z",
  },
];

const canonicalUrl = `https://podomy.com${currentPath.replace(/\/+$/, "") || "/"}${currentPath === "/" ? "" : "/"}`;
const isDocPage = currentPath.startsWith("/docs/") || currentPath.startsWith("/flint/docs/");

const jsonLd = isDocPage
  ? {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: title,
      description: description,
      url: canonicalUrl,
      inLanguage: "en",
      author: {
        "@type": "Organization",
        name: "Podomy",
        url: "https://podomy.com",
      },
      publisher: {
        "@type": "Organization",
        name: "Podomy",
        url: "https://podomy.com",
        logo: "https://podomy.com/logo.png",
      },
    }
  : currentPath.replace(/\/+$/, "") === "/concord" || currentPath === "/concord/"
    ? {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Concord",
        applicationCategory: "DistributedSystemsApplication",
        operatingSystem: "Linux, Embedded POSIX",
        description: description,
        url: canonicalUrl,
        author: {
          "@type": "Organization",
          name: "Podomy",
          url: "https://podomy.com",
        },
      }
    : currentPath.replace(/\/+$/, "") === "/flint" || currentPath === "/flint/"
    ? {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "Flint",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Windows, macOS, Linux",
        description: description,
        url: canonicalUrl,
        author: {
          "@type": "Organization",
          name: "Podomy",
          url: "https://podomy.com",
        },
      }
    : {
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Podomy",
        url: "https://podomy.com",
        description: description,
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="help"
      type="text/plain"
      href="/llms.txt"
      title="LLM Context Manifest"
    />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms-full.txt"
      title="Full Documentation LLM Bundle"
    />
    {
      rawMarkdownUrl && (
        <link
          rel="alternate"
          type="text/markdown"
          href={rawMarkdownUrl}
          title="Raw Markdown Content"
        />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="site-chrome">
      <header class="site-header">
        <BrandLink label="Podomy home" />
        <nav class="site-nav" aria-label="Site">
          {navItems.filter((item) => item.label !== "Concord" && item.label !== "Flint").map((item) => {
            const normalizedCurrent =
              currentPath.replace(/\/+$/, "") || "/";
            const normalizedItem = item.href.replace(/\/+$/, "") || "/";
            const isActive =
              normalizedItem === "/"
                ? normalizedCurrent === "/"
                : normalizedCurrent === normalizedItem ||
                  normalizedCurrent.startsWith(normalizedItem + "/");
            return (
              <a
                href={item.href}
                class:list={["nav-link", { active: isActive }]}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
        <button
            class="hamburger"
            aria-label="Open navigation menu"
            aria-expanded="false"
            aria-controls="mobile-nav-modal"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="4" y1="7" x2="20" y2="7"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="17" x2="20" y2="17"></line>
            </svg>
          </button>
      </header>
      <div id="mobile-nav-modal" class="mobile-nav-modal" aria-hidden="true">
        <div class="mobile-nav-backdrop"></div>
        <div
          class="mobile-nav-panel"
          role="dialog"
          aria-modal="true"
          aria-label="Navigation"
        >
          <div class="mobile-nav-header">
            <BrandLink />
            <button class="mobile-nav-close" aria-label="Close navigation">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <nav class="nav-links mobile-nav-links">
            {
              navItems.map((item) => {
                const normalizedCurrent =
                  currentPath.replace(/\/+$/, "") || "/";
                const normalizedItem = item.href.replace(/\/+$/, "") || "/";
                const isActive =
                  normalizedItem === "/"
                    ? normalizedCurrent === "/"
                    : normalizedCurrent === normalizedItem ||
                      normalizedCurrent.startsWith(normalizedItem + "/");
                return (
                  <a
                    href={item.href}
                    class:list={["mobile-nav-link", { active: isActive }]}
                  >
                    <span>{item.label}</span>
                    {isActive && <span class="mobile-nav-active-dot" />}
                  </a>
                );
              })
            }
          </nav>
        </div>
      </div>
      <div class:list={["main-column", { "docs-wide": isDocPage }]}>
        <main>
          <slot />
        </main>
      </div>
      <footer class="site-footer">
        <div class="footer-inner">
          <div class="footer-group">
            <span class="footer-legal"
              >&copy; 2026 Podomy, Forge Universal LLC</span
            >
            {
              footerLinks.map((item) => (
                <a href={item.href} class="footer-link">
                  {item.label}
                </a>
              ))
            }
          </div>
          <div class="footer-group">
            {
              footerSocial.map((item) => (
                <a
                  href={item.href}
                  class="footer-link footer-icon-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={item.label}
                >
                  <svg
                    class="footer-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path fill="currentColor" d={item.path} />
                  </svg>
                </a>
              ))
            }
          </div>
        </div>
      </footer>
    </div>
    <script>
      function initHamburger() {
        const btn = document.querySelector(".hamburger");
        const modal = document.getElementById("mobile-nav-modal");
        const closeBtn = document.querySelector(".mobile-nav-close");
        const backdrop = document.querySelector(".mobile-nav-backdrop");
        if (!btn || !modal) return;
        const open = () => {
          modal.classList.add("open");
          modal.setAttribute("aria-hidden", "false");
          btn.setAttribute("aria-expanded", "true");
          document.body.style.overflow = "hidden";
        };
        const close = () => {
          modal.classList.remove("open");
          modal.setAttribute("aria-hidden", "true");
          btn.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
        };
        btn.onclick = open;
        if (closeBtn) closeBtn.onclick = close;
        if (backdrop) backdrop.onclick = close;
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && modal.classList.contains("open")) close();
        });
      }
      document.addEventListener("DOMContentLoaded", initHamburger);
      initHamburger();
    </script>
  </body>
</html>
