---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	currentPath?: string;
	docsNav?: Array<{ slug: string; label: string; order?: number }>;
	activeSlug?: string;
}

const {
	title = "Podomy | Distributed Systems & Computational Engineering",
	description = "Podomy builds distributed systems, computational engineering tools, and simulation software for physical machines and decentralized networks.",
	currentPath = "/",
	docsNav,
	activeSlug,
} = Astro.props;

const navItems = [
	{ label: "About", href: "/" },
	{ label: "Concord", href: "/concord/" },
	{ label: "Docs", href: "/docs/" },
	{ label: "Pricing", href: "/pricing/" },
	{ label: "Contact", href: "/contact/" },
];

const footerLinks = [
	{ label: "Licensing", href: "/licensing/" },
	{ label: "Contact", href: "/contact/" },
	{ label: "Terms", href: "/terms/" },
];

const canonicalUrl = `https://podomy.com${currentPath.replace(/\/+$/, "") || "/"}${currentPath === "/" ? "" : "/"}`;
const isDocPage = currentPath.startsWith("/docs/");
const rawMarkdownUrl = isDocPage 
	? `https://podomy.com/docs/${activeSlug || "overview"}.md` 
	: undefined;

const jsonLd = isDocPage ? {
	"@context": "https://schema.org",
	"@type": "TechArticle",
	"headline": title,
	"description": description,
	"url": canonicalUrl,
	"inLanguage": "en",
	"author": {
		"@type": "Organization",
		"name": "Podomy",
		"url": "https://podomy.com"
	},
	"publisher": {
		"@type": "Organization",
		"name": "Podomy",
		"url": "https://podomy.com",
		"logo": "https://podomy.com/logo.png"
	}
} : {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "Concord",
	"applicationCategory": "DistributedSystemsApplication",
	"operatingSystem": "Linux, Embedded POSIX",
	"description": "Partition-native coordination layer for autonomous physical machines.",
	"url": "https://podomy.com/concord/",
	"author": {
		"@type": "Organization",
		"name": "Podomy",
		"url": "https://podomy.com"
	}
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="help" type="text/plain" href="/llms.txt" title="LLM Context Manifest" />
		<link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full Documentation LLM Bundle" />
		{rawMarkdownUrl && (
			<link rel="alternate" type="text/markdown" href={rawMarkdownUrl} title="Raw Markdown Content" />
		)}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content="website" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<ClientRouter />
	</head>
	<body>
		<div class="site-chrome">
			<div class="layout-grid">
				<aside class="sidebar">
					<div class="sidebar-sticky">
						<div class="brand">
							<a href="/" class="brand-link">
								<img
									src="/logo.png"
									alt="Podomy"
									class="brand-logo"
									width="20"
									height="20"
									loading="eager"
									decoding="sync"
									transition:persist="podomy-logo"
								/>
								<span class="brand-name">Podomy</span>
							</a>
						</div>
						{docsNav && docsNav.length > 0 ? (
							<nav class="nav-links docs-nav">
								{docsNav.map((doc) => {
									const docHref = doc.slug === "overview" ? "/docs/" : `/docs/${doc.slug}/`;
									const isDocActive = activeSlug === doc.slug;
									return (
										<a
											href={docHref}
											class:list={["docs-sidebar-link", { active: isDocActive }]}
										>
											{doc.label}
										</a>
									);
								})}
							</nav>
						) : (
							<nav class="nav-links">
								{navItems.map((item) => {
									const normalizedCurrent = currentPath.replace(/\/+$/, "") || "/";
									const normalizedItem = item.href.replace(/\/+$/, "") || "/";
									const isActive = normalizedItem === "/" 
										? normalizedCurrent === "/" 
										: normalizedCurrent === normalizedItem || normalizedCurrent.startsWith(normalizedItem + "/");
									return (
										<div class="nav-item-group">
											<a
												href={item.href}
												class:list={["nav-link", { active: isActive }]}
											>
												{item.label}
											</a>
										</div>
									);
								})}
							</nav>
						)}
					</div>
				</aside>

				<div class="main-column">
					<main>
						<slot />
					</main>

					<footer>
						<div class="footer-inner">
							<span class="footer-legal">&copy; 2026 Podomy &middot; Forge Universal LLC</span>
							<div class="footer-nav">
								{footerLinks.map((item) => (
									<a href={item.href} class="footer-link">{item.label}</a>
								))}
							</div>
						</div>
					</footer>
				</div>
			</div>
		</div>
	</body>
</html>
