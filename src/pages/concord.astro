---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Concord | Podomy"
	description="Concord is a partition-native coordination layer and runtime designed for autonomous machines and disconnected environments."
	currentPath="/concord/"
>
	<section class="hero-section">
		<h1 class="page-title">Concord</h1>
		<p class="page-lead" style="font-weight: 400;">
			Concord is a partition-native coordination layer and runtime for machines beyond the cloud's reach. Workloads keep running when the network drops, state reconciles when it comes back. Built for subsurface mines, subsea robotics, <span class="nowrap">air-gapped</span> industry, and space.
		</p>

		<div class="concord-art-wrapper">
			<img
				src="/assets/concord-robot-light.png"
				alt="Concord autonomous runtime mascot"
				width="160"
				height="160"
				class="concord-art"
			/>
		</div>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">Documentation</h2>
		</div>
		<p class="body-p">
			Specs, CLI, SDK, and deployment guides live in the <a href="/docs/" class="body-link">Documentation</a>.
		</p>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">Licensing & Commercial Support</h2>
		</div>
		<p class="body-p">
			For commercial terms, see <a href="/pricing/" class="body-link">Pricing</a>, or email <a href="mailto:contact@podomy.com" class="body-link">contact@podomy.com</a>.
		</p>
	</section>
</Layout>
