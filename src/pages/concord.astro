---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Concord | Podomy"
	description="Concord is an AP distributed system, a runtime and coordination layer designed for robotic fleets. It gives you highest reliability from warehouse aisles to mines, factories, and space."
	currentPath="/concord/"
>
	<section class="hero-section">
		<h1 class="page-title">Concord</h1>
		<p class="page-lead" style="font-weight: 400;">
			Concord is an AP distributed system, a runtime and coordination layer designed for robotic fleets. It gives you highest reliability from warehouse aisles to mines, factories, and space.
		</p>

		<p class="body-p">
			<a
				href="https://github.com/podomy/concord"
				class="body-link"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="View Concord on GitHub"
				style="display: inline-flex; align-items: center; gap: 6px;"
			>
				<svg
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="currentColor"
					aria-hidden="true"
				>
					<path
						d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.225.825-.51 0-.255-.015-.93-.015-1.62-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23.54.825 1.62 1.41 2.67 1.395.42-.33.795-.855.93-1.41-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.105-3.195 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.645 1.665.225 2.895.105 3.195.765.84 1.23 1.92 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .285.225.63.825.51A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
					></path>
				</svg>
				View on GitHub
			</a>
		</p>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">Documentation</h2>
		</div>
		<p class="body-p">
			Specs, CLI, SDK, and deployment guides live in the <a href="/docs/" class="body-link">Documentation</a>.
		</p>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">Licensing & Commercial Support</h2>
		</div>
		<p class="body-p">
			For commercial terms, see <a href="/pricing/" class="body-link">Pricing</a>, or email <a href="mailto:contact@podomy.com" class="body-link">contact@podomy.com</a>.
		</p>
	</section>
</Layout>
