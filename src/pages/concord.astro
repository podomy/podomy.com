---
import Layout from '../layouts/Layout.astro';
import { buildDocsNav, compareDocs, slugFromPath } from '../lib/docs';

// Concord documentation index, in canonical reading order.
const docModules = import.meta.glob("/docs/*.md", { eager: true });
const docsNav = buildDocsNav(docModules);

const docs = Object.entries(docModules)
	.map(([filepath]) => {
		const slug = slugFromPath(filepath);
		const navItem = docsNav.find((item) => item.slug === slug);
		return {
			slug,
			label: navItem?.label ?? slug,
			order: navItem?.order,
		};
	})
	.sort(compareDocs);
---

<Layout
	title="Concord | Podomy"
	description="Concord is a runtime for machine fleets that lose their network and keep running. Built for space, sea, remote terrain, and underground."
	currentPath="/concord/"
>
	<section>
		<h1 class="page-title">Concord</h1>
		<p class="page-lead">
			Concord is a runtime for machine fleets that lose their network and keep running. Built for space, sea, remote terrain, and underground.
		</p>

		<p class="body-p">
			<a
				href="https://github.com/podomy/concord"
				class="body-link"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="View Concord on GitHub"
				style="display: inline-flex; align-items: center; gap: 6px;"
			>
				<svg
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="currentColor"
					aria-hidden="true"
				>
					<path
						d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.225.825-.51 0-.255-.015-.93-.015-1.62-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23.54.825 1.62 1.41 2.67 1.395.42-.33.795-.855.93-1.41-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.105-3.195 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.645 1.665.225 2.895.105 3.195.765.84 1.23 1.92 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .285.225.63.825.51A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
					></path>
				</svg>
				View on GitHub
			</a>
		</p>
	</section>

	<section class="content-section">
		<h2 class="section-title">Demos</h2>
		<p class="body-p">
			No demos for now.
		</p>
	</section>

	<section class="content-section">
		<h2 class="section-title">Licensing</h2>
		<p class="body-p">
			For commercial terms: <a href="/pricing/" class="body-link">Pricing</a>, or email <a href="mailto:contact@podomy.com" class="body-link">contact@podomy.com</a>.
		</p>
	</section>

	<section class="content-section" id="documentation">
		<h2 class="section-title">Documentation</h2>
		<ul class="docs-anchor-list">
			{docs.map((doc) => (
				<li>
					<a href={doc.slug === "overview" ? `/concord/docs/` : `/concord/docs/${doc.slug}/`} class="body-link docs-anchor-link">
						<svg
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
							<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
						</svg>
						<span>{doc.label}</span>
					</a>
				</li>
			))}
		</ul>

	</section>
</Layout>
