---
import Layout from '../layouts/Layout.astro';
---

<Layout currentPath="/">
	<section>
		<h1 class="page-title">Podomy</h1>
		<p class="page-lead">
			We build distributed systems for robotic fleets.
		</p>
		<blockquote class="fleet-quote">
			<span style="font-variant: small-caps; font-weight: 600; letter-spacing: 0.08em;">fleet</span> any group of autonomous machines acting together
		</blockquote>
	</section>

	<section class="content-section">
		<h2 class="section-title">Projects</h2>

		<div class="projects-mobile">
			<article class="project-card">
				<div>
					<a href="/concord/" class="project-title body-link">Concord</a>
					<p class="project-sub">Coordination</p>
				</div>
				<p class="project-desc">
					Runtime for machine fleets that lose their network and keep running. Built for space, sea, remote terrain, and underground.
				</p>
				<div style="margin-top: 10px;">
					<a href="/concord/" class="body-link">Learn more</a>
				</div>
			</article>
			<article class="project-card">
				<div>
					<a href="/weld/" class="project-title body-link">Weld</a>
					<p class="project-sub">Middleware</p>
				</div>
				<p class="project-desc">
					Robotics middleware in Go with a fully compatible ROS 2 interface and native support for any transport.
				</p>
				<div style="margin-top: 10px;">
					<a href="/weld/" class="body-link">Learn more</a>
				</div>
			</article>
			<article class="project-card">
				<div>
					<a href="/tardigrade/" class="project-title body-link">Tardigrade</a>
					<p class="project-sub">Database</p>
				</div>
				<p class="project-desc">
					Consistent and partition-tolerant distributed SQL database. Serializable transactions, Raft replication, PostgreSQL wire compatible.
				</p>
				<div style="margin-top: 10px;">
					<a href="/tardigrade/" class="body-link">Learn more</a>
				</div>
			</article>
			<article class="project-card">
				<div>
					<a href="/resonance/" class="project-title body-link">Resonance</a>
					<p class="project-sub">Simulation</p>
				</div>
				<p class="project-desc">
					High-fidelity simulator and regression harness for Concord. Runs real binaries over a simulated radio mesh to assert convergence.
				</p>
				<div style="margin-top: 10px;">
					<a href="/resonance/" class="body-link">Learn more</a>
				</div>
			</article>
		</div>

		<table class="projects-table">
			<tbody>
				<tr>
					<td class="td-name">
						<a href="/concord/" class="body-link"><strong>Concord</strong></a>
					</td>
					<td class="td-role">
						Coordination
					</td>
					<td class="td-desc">
						<p style="margin: 0 0 8px;">
							Runtime for machine fleets that lose their network and keep running. Built for space, sea, remote terrain, and underground.
						</p>
						<a href="/concord/" class="body-link">Learn more</a>
					</td>
				</tr>
				<tr>
					<td class="td-name">
						<a href="/weld/" class="body-link"><strong>Weld</strong></a>
					</td>
					<td class="td-role">
						Middleware
					</td>
					<td class="td-desc">
						<p style="margin: 0 0 8px;">
							Robotics middleware in Go with a fully compatible ROS 2 interface and native support for any transport.
						</p>
						<a href="/weld/" class="body-link">Learn more</a>
					</td>
				</tr>
				<tr>
					<td class="td-name">
						<a href="/tardigrade/" class="body-link"><strong>Tardigrade</strong></a>
					</td>
					<td class="td-role">
						Database
					</td>
					<td class="td-desc">
						<p style="margin: 0 0 8px;">
							Consistent and partition-tolerant distributed SQL database. Serializable transactions, Raft replication, PostgreSQL wire compatible.
						</p>
						<a href="/tardigrade/" class="body-link">Learn more</a>
					</td>
				</tr>
				<tr>
					<td class="td-name">
						<a href="/resonance/" class="body-link"><strong>Resonance</strong></a>
					</td>
					<td class="td-role">
						Simulation
					</td>
					<td class="td-desc">
						<p style="margin: 0 0 8px;">
							High-fidelity simulator and regression harness for Concord. Runs real binaries over a simulated radio mesh to assert convergence.
						</p>
						<a href="/resonance/" class="body-link">Learn more</a>
					</td>
				</tr>
			</tbody>
		</table>
	</section>

	<section class="content-section">
		<h2 class="section-title">Working with us</h2>
		<p class="body-p">
			Licenses from $10,000 per year. No SLAs. No support contracts. Assurance and consulting available separately.
		</p>
		<p class="body-p">
			<a href="/pricing/" class="body-link">See pricing</a><svg class="dot-sep" width="4" height="4" viewBox="0 0 4 4" aria-hidden="true"><circle cx="2" cy="2" r="2" fill="currentColor"/></svg><a href="/contact/" class="body-link">Contact engineering</a>
		</p>
	</section>
</Layout>

