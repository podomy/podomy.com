---
import Layout from '../layouts/Layout.astro';
---

<Layout currentPath="/">
	<section class="hero-section">
		<h1 class="page-lead" style="font-weight: 400;">
			Distributed systems and computational engineering for machines that run without the cloud. Assume the worst. Build accordingly.
		</h1>
		<p class="body-p">
			We build runtime infrastructure, simulation software, geometric kernels, and CAD/CAM tooling.
		</p>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">Projects</h2>
		</div>

		<div class="projects-mobile">
			<article class="project-card">
				<div class="project-card-top">
					<div>
						<a href="/concord/" class="project-title body-link">Concord</a>
						<p class="project-sub">Coordination</p>
					</div>
				</div>
				<p class="project-desc">
					Coordination for machines that keep running when the network drops.
				</p>
				<div style="margin-top: 10px;">
					<a href="/concord/" class="body-link">Read specs</a>
				</div>
			</article>
		</div>

		<table class="projects-table">
			<tbody>
				<tr>
					<td class="td-name">
						<a href="/concord/" class="body-link"><strong>Concord</strong></a>
					</td>
					<td class="td-role">
						Coordination
					</td>
					<td class="td-desc">
						<p style="margin: 0 0 8px;">
							Coordination for machines that keep running when the network drops.
						</p>
						<a href="/concord/" class="body-link">Read specs</a>
					</td>
				</tr>
			</tbody>
		</table>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">Working with us</h2>
		</div>
		<p class="body-p">
			Commercial licenses start at $10,000 per year.
		</p>
		<p class="body-p">
			<a href="/pricing/" class="body-link">See pricing</a><svg class="dot-sep" width="4" height="4" viewBox="0 0 4 4" aria-hidden="true"><circle cx="2" cy="2" r="2" fill="currentColor"/></svg><a href="/licensing/" class="body-link">Licensing</a><svg class="dot-sep" width="4" height="4" viewBox="0 0 4 4" aria-hidden="true"><circle cx="2" cy="2" r="2" fill="currentColor"/></svg><a href="/contact/" class="body-link">Contact engineering</a>
		</p>
	</section>
</Layout>
