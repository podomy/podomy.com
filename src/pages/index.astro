---
import Layout from '../layouts/Layout.astro';
---

<Layout currentPath="/">
	<section class="hero-section">
		<h1 class="page-lead" style="font-weight: 400;">
			<span style="font-variant: small-caps; font-weight: 600; letter-spacing: 0.08em;">podomy</span> builds distributed systems for robotic fleets.
		</h1>
		<blockquote class="fleet-quote">
			<span style="font-variant: small-caps; font-weight: 600; letter-spacing: 0.08em;">fleet</span> any group of autonomous machines acting together
		</blockquote>
		<style>
			.fleet-quote {
				position: relative;
				background: #fefce8;
				border: 1px solid #fde68a;
				padding: 16px 18px 16px 44px;
				margin: 16px 0 0;
				color: #44403c;
				font-size: 0.95rem;
				line-height: 1.7;
			}
			.fleet-quote::before {
				content: "\201C";
				position: absolute;
				left: 12px;
				top: 2px;
				font-family: Georgia, "Times New Roman", serif;
				font-size: 2.4rem;
				line-height: 1;
				color: #f59e0b;
			}
		</style>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">Projects</h2>
		</div>

		<div class="projects-mobile">
			<article class="project-card">
				<div class="project-card-top">
					<div>
						<a href="/concord/" class="project-title body-link">Concord</a>
						<p class="project-sub">Coordination</p>
					</div>
				</div>
				<p class="project-desc">
					AP distributed system, a runtime and coordination layer for robotic fleets.
				</p>
				<div style="margin-top: 10px;">
					<a href="/concord/" class="body-link">Read specs</a>
				</div>
			</article>
		</div>

		<table class="projects-table">
			<tbody>
				<tr>
					<td class="td-name">
						<a href="/concord/" class="body-link"><strong>Concord</strong></a>
					</td>
					<td class="td-role">
						Coordination
					</td>
					<td class="td-desc">
						<p style="margin: 0 0 8px;">
							AP distributed system, a runtime and coordination layer for robotic fleets.
						</p>
						<a href="/concord/" class="body-link">Read specs</a>
					</td>
				</tr>
			</tbody>
		</table>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">Working with us</h2>
		</div>
		<p class="body-p">
			Licenses from $10,000 per year. No SLAs. No support contracts.
		</p>
		<p class="body-p">
			<a href="/pricing/" class="body-link">See pricing</a><svg class="dot-sep" width="4" height="4" viewBox="0 0 4 4" aria-hidden="true"><circle cx="2" cy="2" r="2" fill="currentColor"/></svg><a href="/contact/" class="body-link">Contact engineering</a>
		</p>
	</section>
</Layout>
