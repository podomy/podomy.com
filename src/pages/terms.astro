	description="Podomy Terms of Service - Forge Universal LLC"
	currentPath="/terms/"
>
	<h1 class="page-title">Terms of Service</h1>
	<p class="sub-p" style="margin-bottom: 24px; color: #78716c;">Last updated: June 24, 2026</p>

	<section class="content-section" style="margin-top: 0;">
		<h2 class="section-title">Overview</h2>
		<p class="body-p">
			Podomy is operated by Forge Universal LLC. These terms govern your use of Podomy websites, software, documentation, and services. By using our site or software, you agree to these terms.
		</p>
	</section>

	<section class="content-section">
		<h2 class="section-title">Licensing & Commercial Use</h2>
		<p class="body-p">
			Our core software is open source under the GNU Affero General Public License (AGPLv3). If you incorporate Podomy software into proprietary applications or require commercial terms without copyleft obligations, you must obtain a commercial license. In the event of any conflict, your written commercial license agreement takes precedence over these general terms.
		</p>
	</section>

	<section class="content-section">
		<h2 class="section-title">Billing & Fair Treatment</h2>
