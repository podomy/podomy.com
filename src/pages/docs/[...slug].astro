---
import Layout from "../../layouts/Layout.astro";
import { buildDocsNav, slugFromPath } from "../../lib/docs";

export async function getStaticPaths() {
  const docModules = import.meta.glob("/docs/*.md", { eager: true });
  const docsNav = buildDocsNav(docModules);

  const paths = [];

  for (const [filepath, module] of Object.entries(docModules)) {
    const filename = slugFromPath(filepath);
    const doc = module as any;

    // Main route: /docs/ for overview, /docs/<slug>/ for others
    if (filename === "overview") {
      paths.push({
        params: { slug: undefined },
        props: { doc, docsNav, activeSlug: "overview" },
      });
      paths.push({
        params: { slug: "overview" },
        props: { doc, docsNav, activeSlug: "overview" },
      });
    } else {
      paths.push({
        params: { slug: filename },
        props: { doc, docsNav, activeSlug: filename },
      });
    }
  }

  return paths;
}

const docModules = import.meta.glob("/docs/*.md", { eager: true });
let { doc, docsNav, activeSlug } = Astro.props as any;

// Fallback for direct/dev requests that bypass getStaticPaths props.
if (!doc || !docsNav || !activeSlug) {
  let paramSlug = Astro.params.slug || "overview";
  if (paramSlug.endsWith(".md")) {
    paramSlug = paramSlug.replace(/\.md$/, "");
  }
  activeSlug = paramSlug;

  const targetKey = Object.keys(docModules).find((k) =>
    k.endsWith(`/${activeSlug}.md`)
  );
  doc = targetKey ? (docModules[targetKey] as any) : null;
  docsNav = buildDocsNav(docModules);
}

if (!doc) {
  return Astro.redirect("/docs/");
}

const { Content, frontmatter, getHeadings } = doc;

// Determine title from first heading or slug
const headings = getHeadings ? getHeadings() : [];
const pageTitle =
  frontmatter?.title ||
  headings[0]?.text ||
  activeSlug.charAt(0).toUpperCase() + activeSlug.slice(1);

// Determine previous and next docs for footer pagination
const currentIndex = docsNav.findIndex((item: any) => item.slug === activeSlug);
const prevDoc = currentIndex > 0 ? docsNav[currentIndex - 1] : null;
const nextDoc = currentIndex !== -1 && currentIndex < docsNav.length - 1 ? docsNav[currentIndex + 1] : null;
---

<Layout
  title={`${pageTitle} | Docs | Podomy`}
  description="Concord partition-native coordination runtime documentation."
  currentPath={Astro.url.pathname}
  docsNav={docsNav}
  activeSlug={activeSlug}
>
  <div class="docs-wrapper">
    <article class="markdown-body">
      <Content />
    </article>

    <div class="docs-pagination">
      {prevDoc ? (
        <a
          href={prevDoc.slug === "overview" ? "/docs/" : `/docs/${prevDoc.slug}/`}
          class="docs-pag-btn prev"
        >
          <span class="docs-pag-sub">&larr; Previous</span>
          <span class="docs-pag-title">{prevDoc.label}</span>
        </a>
      ) : <div class="docs-pag-placeholder" />}
      {nextDoc ? (
        <a
          href={nextDoc.slug === "overview" ? "/docs/" : `/docs/${nextDoc.slug}/`}
          class="docs-pag-btn next"
        >
          <span class="docs-pag-sub">Next &rarr;</span>
          <span class="docs-pag-title">{nextDoc.label}</span>
        </a>
      ) : <div class="docs-pag-placeholder" />}
    </div>
  </div>
</Layout>



