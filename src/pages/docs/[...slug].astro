---
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const docModules = import.meta.glob("/docs/*.md", { eager: true });

  // Dynamically build documentation navigation from existing modules
  const rawNav = Object.entries(docModules).map(([filepath, module]) => {
    const filename = filepath.split("/").pop()?.replace(".md", "") || "";
    const doc = module as any;
    const headings = doc.getHeadings ? doc.getHeadings() : [];
    const firstH1 =
      headings.find((h: any) => h.depth === 1)?.text || headings[0]?.text;

    const label =
      doc.frontmatter?.navTitle ||
      doc.frontmatter?.title ||
      firstH1 ||
      filename
        .replace(/[-_]/g, " ")
        .replace(/\b\w/g, (c: string) => c.toUpperCase());

    const order =
      typeof doc.frontmatter?.order === "number"
        ? doc.frontmatter.order
        : undefined;

    return {
      slug: filename,
      label,
      order,
    };
  });

  const preferredOrder = [
    "overview",
    "architecture",
    "cli",
    "sdk",
    "deployment",
  ];

  const docsNav = rawNav.sort((a, b) => {
    if (a.order !== undefined && b.order !== undefined) {
      return a.order - b.order;
    }
    const aIndex = preferredOrder.indexOf(a.slug);
    const bIndex = preferredOrder.indexOf(b.slug);
    if (aIndex !== -1 && bIndex !== -1) {
      return aIndex - bIndex;
    }
    if (aIndex !== -1) return -1;
    if (bIndex !== -1) return 1;
    return a.slug.localeCompare(b.slug);
  });

  const paths = [];

  for (const [filepath, module] of Object.entries(docModules)) {
    const filename = filepath.split("/").pop()?.replace(".md", "") || "";
    const doc = module as any;

    // Main route: /docs/ for overview, /docs/<slug>/ for others
    if (filename === "overview") {
      paths.push({
        params: { slug: undefined },
        props: { doc, docsNav, activeSlug: "overview" },
      });
      paths.push({
        params: { slug: "overview" },
        props: { doc, docsNav, activeSlug: "overview" },
      });
    } else {
      paths.push({
        params: { slug: filename },
        props: { doc, docsNav, activeSlug: filename },
      });
    }
  }

  return paths;
}

const docModules = import.meta.glob("/docs/*.md", { eager: true });
let { doc, docsNav, activeSlug } = Astro.props as any;

if (!doc || !docsNav || !activeSlug) {
  let paramSlug = Astro.params.slug || "overview";
  if (paramSlug.endsWith(".md")) {
    paramSlug = paramSlug.replace(/\.md$/, "");
  }
  activeSlug = paramSlug;

  const targetKey = Object.keys(docModules).find((k) =>
    k.endsWith(`/${activeSlug}.md`)
  );
  doc = targetKey ? (docModules[targetKey] as any) : null;

  const rawNav = Object.entries(docModules).map(([filepath, module]) => {
    const filename = filepath.split("/").pop()?.replace(".md", "") || "";
    const d = module as any;
    const headings = d.getHeadings ? d.getHeadings() : [];
    const firstH1 =
      headings.find((h: any) => h.depth === 1)?.text || headings[0]?.text;

    const label =
      d.frontmatter?.navTitle ||
      d.frontmatter?.title ||
      firstH1 ||
      filename
        .replace(/[-_]/g, " ")
        .replace(/\b\w/g, (c: string) => c.toUpperCase());

    const order =
      typeof d.frontmatter?.order === "number"
        ? d.frontmatter.order
        : undefined;

    return {
      slug: filename,
      label,
      order,
    };
  });

  const preferredOrder = [
    "overview",
    "architecture",
    "cli",
    "sdk",
    "deployment",
  ];

  docsNav = rawNav.sort((a, b) => {
    if (a.order !== undefined && b.order !== undefined) {
      return a.order - b.order;
    }
    const aIndex = preferredOrder.indexOf(a.slug);
    const bIndex = preferredOrder.indexOf(b.slug);
    if (aIndex !== -1 && bIndex !== -1) {
      return aIndex - bIndex;
    }
    if (aIndex !== -1) return -1;
    if (bIndex !== -1) return 1;
    return a.slug.localeCompare(b.slug);
  });
}

if (!doc) {
  return Astro.redirect("/docs/");
}

const { Content, frontmatter, getHeadings } = doc;

// Determine title from first heading or slug
const headings = getHeadings ? getHeadings() : [];
const pageTitle =
  frontmatter?.title ||
  headings[0]?.text ||
  activeSlug.charAt(0).toUpperCase() + activeSlug.slice(1);

// Determine previous and next docs for footer pagination
const currentIndex = docsNav.findIndex((item: any) => item.slug === activeSlug);
const prevDoc = currentIndex > 0 ? docsNav[currentIndex - 1] : null;
const nextDoc = currentIndex !== -1 && currentIndex < docsNav.length - 1 ? docsNav[currentIndex + 1] : null;
---

<Layout
  title={`${pageTitle} | Docs | Podomy`}
  description="Concord partition-native coordination runtime documentation."
  currentPath={Astro.url.pathname}
  docsNav={docsNav}
  activeSlug={activeSlug}
>
  <div class="docs-wrapper">
    <div class="doc-meta-header">
      <div class="doc-meta-left">
        <span class="doc-tag">Concord v1.0</span>
        <span>Documentation</span>
      </div>
      <div class="doc-actions">
        <button
          type="button"
          class="doc-action-btn copy-markdown-btn"
          id="copy-md-btn"
          title="Copy raw markdown content to clipboard for LLMs and AI prompts"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span class="btn-text">Copy Markdown</span>
        </button>
        <a
          href={`/docs/${activeSlug}.md`}
          class="doc-action-btn"
          target="_blank"
          rel="noopener noreferrer"
          title="Open raw markdown plain text"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          <span>Raw .md</span>
        </a>
      </div>
    </div>

    <article class="markdown-body">
      <Content />
    </article>

    <div class="docs-pagination">
      {prevDoc ? (
        <a
          href={prevDoc.slug === "overview" ? "/docs/" : `/docs/${prevDoc.slug}/`}
          class="docs-pag-btn prev"
        >
          <span class="docs-pag-sub">&larr; Previous</span>
          <span class="docs-pag-title">{prevDoc.label}</span>
        </a>
      ) : <div class="docs-pag-placeholder" />}
      {nextDoc ? (
        <a
          href={nextDoc.slug === "overview" ? "/docs/" : `/docs/${nextDoc.slug}/`}
          class="docs-pag-btn next"
        >
          <span class="docs-pag-sub">Next &rarr;</span>
          <span class="docs-pag-title">{nextDoc.label}</span>
        </a>
      ) : <div class="docs-pag-placeholder" />}
    </div>
  </div>
</Layout>

<script>
  function initCopyButton() {
    const btn = document.getElementById("copy-md-btn");
    if (!btn) return;

    btn.onclick = async () => {
      try {
        let path = window.location.pathname.replace(/\/+$/, "");
        if (path === "" || path === "/docs") {
          path = "/docs/overview";
        }
        const targetUrl = path + ".md";
        const res = await fetch(targetUrl);
        const text = res.ok ? await res.text() : "";
        if (text) {
          await navigator.clipboard.writeText(text);
          const textSpan = btn.querySelector(".btn-text");
          if (textSpan) textSpan.textContent = "Copied!";
          btn.classList.add("copied");
          setTimeout(() => {
            if (textSpan) textSpan.textContent = "Copy Markdown";
            btn.classList.remove("copied");
          }, 2000);
        }
      } catch (e) {
        console.error("Failed to copy markdown", e);
      }
    };
  }

  document.addEventListener("astro:page-load", initCopyButton);
  initCopyButton();
</script>

