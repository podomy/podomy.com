---
import Layout from "../../layouts/Layout.astro";
import { buildDocsNav, slugFromPath } from "../../lib/docs";

export async function getStaticPaths() {
  const docModules = import.meta.glob("/docs/*.md", { eager: true });
  const docsNav = buildDocsNav(docModules);

  const paths = [];

  for (const [filepath, module] of Object.entries(docModules)) {
    const filename = slugFromPath(filepath);
    const doc = module as any;

    // Main route: /docs/ for overview, /docs/<slug>/ for others
    if (filename === "overview") {
      paths.push({
        params: { slug: undefined },
        props: { doc, docsNav, activeSlug: "overview" },
      });
      paths.push({
        params: { slug: "overview" },
        props: { doc, docsNav, activeSlug: "overview" },
      });
    } else {
      paths.push({
        params: { slug: filename },
        props: { doc, docsNav, activeSlug: filename },
      });
    }
  }

  return paths;
}

const docModules = import.meta.glob("/docs/*.md", { eager: true });
let { doc, docsNav, activeSlug } = Astro.props as any;

// Fallback for direct/dev requests that bypass getStaticPaths props.
if (!doc || !docsNav || !activeSlug) {
  let paramSlug = Astro.params.slug || "overview";
  if (paramSlug.endsWith(".md")) {
    paramSlug = paramSlug.replace(/\.md$/, "");
  }
  activeSlug = paramSlug;

  const targetKey = Object.keys(docModules).find((k) =>
    k.endsWith(`/${activeSlug}.md`)
  );
  doc = targetKey ? (docModules[targetKey] as any) : null;
  docsNav = buildDocsNav(docModules);
}

if (!doc) {
  return Astro.redirect("/docs/");
}

const { Content, frontmatter, getHeadings } = doc;

// Determine title from first heading or slug
const headings = getHeadings ? getHeadings() : [];
const pageTitle =
  frontmatter?.title ||
  headings[0]?.text ||
  activeSlug.charAt(0).toUpperCase() + activeSlug.slice(1);

// Determine previous and next docs for footer pagination
const currentIndex = docsNav.findIndex((item: any) => item.slug === activeSlug);
const prevDoc = currentIndex > 0 ? docsNav[currentIndex - 1] : null;
const nextDoc = currentIndex !== -1 && currentIndex < docsNav.length - 1 ? docsNav[currentIndex + 1] : null;
---

<Layout
  title={`${pageTitle} | Docs | Podomy`}
  description="Concord partition-native coordination runtime documentation."
  currentPath={Astro.url.pathname}
  docsNav={docsNav}
  activeSlug={activeSlug}
>
  <div class="docs-wrapper">
    <article class="markdown-body">
      <Content />
    </article>

    <div class="docs-pagination">
      {prevDoc ? (
        <a
          href={prevDoc.slug === "overview" ? "/docs/" : `/docs/${prevDoc.slug}/`}
          class="docs-pag-btn prev"
        >
          <span class="docs-pag-sub">&larr; Previous</span>
          <span class="docs-pag-title">{prevDoc.label}</span>
        </a>
      ) : <div class="docs-pag-placeholder" />}
      {nextDoc ? (
        <a
          href={nextDoc.slug === "overview" ? "/docs/" : `/docs/${nextDoc.slug}/`}
          class="docs-pag-btn next"
        >
          <span class="docs-pag-sub">Next &rarr;</span>
          <span class="docs-pag-title">{nextDoc.label}</span>
        </a>
      ) : <div class="docs-pag-placeholder" />}
    </div>
  </div>

  <style>
    .mermaid {
      background: #ffffff;
      border: 1px solid #e7e5e4;
      border-radius: 4px;
      padding: 16px 12px;
      margin: 0 0 20px;
      overflow-x: auto;
      font-size: 0.85rem;
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .mermaid svg {
      max-width: 100%;
      height: auto;
      display: block;
      margin: 0 auto;
    }
  </style>

  <script>
    /** Mermaid diagram keywords that mark a code block as a diagram. */
    var MERMAID_KEYWORDS = [
      "flowchart",
      "graph",
      "sequenceDiagram",
      "classDiagram",
      "stateDiagram",
      "erDiagram",
      "gantt",
      "pie",
      "packet",
    ];

    /** Return true when plain text looks like a Mermaid diagram source. */
    function isMermaidSource(text) {
      var first = (text || "").trim().split("\n")[0] || "";
      var head = first.trim();
      for (var i = 0; i < MERMAID_KEYWORDS.length; i++) {
        if (head.indexOf(MERMAID_KEYWORDS[i]) === 0) return true;
      }
      return false;
    }

    /** Replace Mermaid code blocks with render targets, then render them. */
    async function renderMermaid() {
      var blocks = document.querySelectorAll(
        ".markdown-body pre.astro-code, .markdown-body pre"
      );
      var targets = [];
      blocks.forEach(function (pre) {
        if (pre.dataset.mermaidDone === "1") return;
        var code = pre.querySelector("code");
        var source = code ? code.innerText : pre.textContent;
        if (!source || !isMermaidSource(source)) return;
        var div = document.createElement("div");
        div.className = "mermaid";
        div.textContent = source.trim();
        pre.replaceWith(div);
        targets.push(div);
      });
      if (targets.length === 0) return;
      try {
        var mermaid = (
          await import(
            "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
          )
        ).default;
        mermaid.initialize({
          startOnLoad: false,
          theme: "base",
          themeVariables: {
            background: "#ffffff",
            primaryColor: "#eff6ff",
            primaryBorderColor: "#1d4ed8",
            primaryTextColor: "#0c0a09",
            secondaryColor: "#fafaf9",
            secondaryBorderColor: "#d6d3d1",
            tertiaryColor: "#f5f5f4",
            lineColor: "#57534e",
            textColor: "#1c1917",
            mainBkg: "#eff6ff",
            nodeBorder: "#1d4ed8",
            clusterBkg: "#fafaf9",
            clusterBorder: "#d6d3d1",
            edgeLabelBackground: "#ffffff",
          },
          flowchart: { curve: "linear", htmlLabels: true },
          sequence: { mirrorActors: false },
        });
        await mermaid.run({ nodes: targets });
        targets.forEach(function (el) {
          el.style.whiteSpace = "";
        });
      } catch (err) {
        console.warn("Mermaid render skipped:", err);
      }
    }

    document.addEventListener("DOMContentLoaded", renderMermaid);
    document.addEventListener("astro:page-load", renderMermaid);
    renderMermaid();
  </script>
</Layout>



