---
import Layout from "../../../layouts/Layout.astro";
import { slugFromPath } from "../../../lib/docs";

export async function getStaticPaths() {
  const docModules = import.meta.glob("/docs/*.md", { eager: true });

  const paths = [];

  for (const [filepath, module] of Object.entries(docModules)) {
    const filename = slugFromPath(filepath);
    const doc = module as any;

    // Main route: /concord/docs/ for overview, /concord/docs/<slug>/ for others
    if (filename === "overview") {
      paths.push({
        params: { slug: undefined },
        props: { doc, activeSlug: "overview" },
      });
      paths.push({
        params: { slug: "overview" },
        props: { doc, activeSlug: "overview" },
      });
    } else {
      paths.push({
        params: { slug: filename },
        props: { doc, activeSlug: filename },
      });
    }
  }

  return paths;
}

const docModules = import.meta.glob("/docs/*.md", { eager: true });
let { doc, activeSlug } = Astro.props as any;

// Fallback for direct/dev requests that bypass getStaticPaths props.
if (!doc || !activeSlug) {
  let paramSlug = Astro.params.slug || "overview";
  if (paramSlug.endsWith(".md")) {
    paramSlug = paramSlug.replace(/\.md$/, "");
  }
  activeSlug = paramSlug;

  const targetKey = Object.keys(docModules).find((k) =>
    k.endsWith(`/${activeSlug}.md`)
  );
  doc = targetKey ? (docModules[targetKey] as any) : null;
}

if (!doc) {
  return Astro.redirect("/concord/#documentation");
}

const { Content, frontmatter, getHeadings } = doc;

// Determine title from first heading or slug
const headings = getHeadings ? getHeadings() : [];
const pageTitle =
  frontmatter?.title ||
  headings[0]?.text ||
  activeSlug.charAt(0).toUpperCase() + activeSlug.slice(1);
---

<Layout
  title={`${pageTitle} | Concord Docs | Podomy`}
  description="Concord partition-native coordination runtime documentation."
  currentPath={Astro.url.pathname}
>
  <p class="docs-back-link">
    <a href="/concord/#documentation" class="body-link docs-anchor-link">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>Back to Documentation</span>
    </a>
  </p>
  <article class="markdown-body">
    <Content />
  </article>
</Layout>
