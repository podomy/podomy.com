---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Licensing | Podomy"
	description="Podomy software is dual-licensed under AGPLv3 for open source use and commercial licenses for proprietary integration."
	currentPath="/licensing/"
>
	<h1 class="page-title">Licensing</h1>
	<p class="page-lead">
		Our software is licensed two ways: open (AGPLv3) or commercial.
	</p>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">License Options</h2>
		</div>
		<ol class="numbered-list">
			<li>
				<div>
					<strong>AGPLv3 (Open Source):</strong> Free. Run, modify, and distribute, as long as your changes stay open.
				</div>
			</li>
			<li>
				<div>
					<strong>Commercial License:</strong> For embedding in proprietary products, closed controllers, or <span class="nowrap">air-gapped</span> fleets. Includes warranty, indemnity, and engineering support.
				</div>
			</li>
		</ol>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">Purchasing & Inquiries</h2>
		</div>
		<p class="body-p">
			See <a href="/pricing/" class="body-link">pricing</a>, or email <a href="mailto:contact@podomy.com" class="body-link">contact@podomy.com</a>.
		</p>
	</section>
</Layout>
