---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact | Podomy"
	description="Get in touch with Podomy engineering for commercial licensing, architecture reviews, and systems software inquiries."
	currentPath="/contact/"
>
	<h1 class="page-title">Contact</h1>
	<p class="page-lead">
		Direct communication with the engineers building the software.
	</p>

	<section class="content-section" style="margin-top: 0;">
		<p class="body-p">
			When you reach out to Podomy, your message goes directly to our core engineering team, not a sales queue, account manager, or automated support bot.
		</p>
		<p class="body-p">
			For serious technical inquiries and commercial licensing, we typically respond within a few hours, and almost always within 24 hours.
		</p>
		<div class="meta-row-group">
			<div class="meta-row">
				<span class="meta-label">Email</span>
				<a href="mailto:contact@podomy.com" class="body-link">contact@podomy.com</a>
			</div>
		</div>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">Privacy & Discretion</h2>
		</div>
		<ol class="numbered-list">
			<li>
				<span><strong>Client Privacy:</strong> We never disclose client emails, active contracts, or communications.</span>
			</li>
			<li>
				<span><strong>Zero Disclosure:</strong> We share zero details on our internal operations, team identities, or employment history.</span>
			</li>
			<li>
				<span><strong>Filtering:</strong> We only reply to relevant technical and commercial inquiries.</span>
			</li>
		</ol>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">What to reach out about</h2>
		</div>
		<p class="body-p">
			Commercial dual-licensing to embed Concord or other Podomy software into proprietary platforms without copyleft obligations.
		</p>
		<p class="body-p">
			Partition-tolerant system architecture for autonomous fleets, subsurface robotics, or multi-axis machinery.
		</p>
		<p class="body-p">
			Custom simulation engines, geometric kernel adaptations, CAM toolpath integration, or specialized runtime drivers.
		</p>
	</section>
</Layout>
