---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact | Podomy"
	description="Get in touch with Podomy engineering for commercial licensing, architecture reviews, and systems software inquiries."
	currentPath="/contact/"
>
	<h1 class="page-title">Contact</h1>
	<p class="page-lead" style="font-weight: 400;">
		Talk directly to the engineers building the software.
	</p>

	<section class="content-section" style="margin-top: 0;">
		<p class="body-p">
			No sales queue. No account manager. No bot.
		</p>
		<p class="body-p">
			<strong><a href="mailto:contact@podomy.com" class="body-link">contact@podomy.com</a></strong>
		</p>
		<p class="body-p">
			We reply within a few hours, always within 24.
		</p>
	</section>

	<section class="content-section">
		<div class="section-header">
			<h2 class="section-title">What happens next</h2>
		</div>
		<ol class="numbered-list">
			<li>
				<span><strong>We talk.</strong> Your machines, network, and workloads.</span>
			</li>
			<li>
				<span><strong>You evaluate Concord.</strong> Docs or a pilot on your hardware.</span>
			</li>
			<li>
				<span><strong>You get a license.</strong> A quote for your tier. No negotiation theater.</span>
			</li>
		</ol>
	</section>

	<p class="body-p">
		Your communications and deployment details stay private.
	</p>
	<p class="body-p">
		For pricing, see the <a href="/pricing/" class="body-link">Pricing page</a>.
	</p>
</Layout>
